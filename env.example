# Telegram Bot Token (отримайте у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID адміністраторів (через кому, без пробілів)
# Щоб дізнатись свій ID, напишіть @userinfobot
ADMIN_IDS=123456789,987654321

# База даних (не змінюйте для SQLite)
DATABASE_URL=sqlite+aiosqlite:///./gameclub.db

# Інформація про клуб
CLUB_NAME=Герої на полицях
CLUB_DESCRIPTION=Ігротека настільних ігор

