{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "startCommand": "python main.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "volumes": [
    {
      "name": "bot-data",
      "mountPath": "/app/data"
    },
    {
      "name": "images-storage",
      "mountPath": "/app/static/images"
    }
  ]
}
